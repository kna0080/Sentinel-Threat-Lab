// Detect LSASS process memory dumping via Sysmon Event ID 10
   Event
   | where Source == "Microsoft-Windows-Sysmon" and EventID == 10
   | extend RenderedDescription = tostring(EventData.RenderedDescription)
   | extend TargetImage = tostring(EventData.TargetImage)
   | extend GrantedAccess = tostring(EventData.GrantedAccess)
   | extend SourceImage = tostring(EventData.SourceImage)
   | where TargetImage has "lsass.exe" 
   | where GrantedAccess == "0x1F1FFF" or GrantedAccess has "0x1410"
   | project TimeGenerated, Computer, SourceImage, TargetImage, GrantedAccess
